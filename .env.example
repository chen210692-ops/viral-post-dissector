# 复制为 .env 后按需修改
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# true 时不请求外部 API，采集和 LLM 都走内置 mock，适合 demo / CI
MOCK_MODE=true

# 本地 SQLite；生产环境可以替换成 PostgreSQL 等 SQLAlchemy URL
DATABASE_URL=sqlite:///data/posts.db

# 平台 API key：没有则自动降级到 HTTP Adapter 骨架；当前仅保留接口位
XHS_API_KEY=
BILIBILI_API_KEY=
JIK_API_KEY=
TWITTER_BEARER_TOKEN=

LOG_LEVEL=INFO
